@page "/settings"
@using BudgetPlanner.Cache
@using BudgetPlanner.Services
@using PlannerModel.Classes
@using PlannerModel.Enums
@inject NavigationManager Navigation
@inject ThemeService ThemeService;

<h1>Settings</h1>
<p>Hier kannst du Einstellungen für deinen Account festlegen.</p>

<EditForm Model="ViewModel" OnValidSubmit="SaveSettings">

    <DataAnnotationsValidator />

    <table class="table table-borderless" style="max-width:700px">
        <tbody>
            <tr>
                <td style="width:40%">
                    <label class="form-label">Design</label>
                    <div class="form-text">Wähle ein Design aus.</div>
                </td>
                <td>
                    <InputSelect class="form-control" @bind-Value="theme">
                        @foreach (var mode in Enum.GetValues(typeof(ThemeModeEnum)))
                        {
                            <option value="@mode">@mode</option>
                        }
                    </InputSelect>
                    @* currently no validation needed *@
                    @* <ValidationMessage For="() => ViewModel.DarkMode" /> *@
                </td>
            </tr>
            <tr>
                <td>
                    <lable class="form-label">Währung</lable>
                    <div class="from-text">z.B. "EUR | Euro"</div>
                </td>
                <td>
                    <InputSelect class="form-control" @bind-Value="ViewModel.PreferredCurrencyId">
                        @foreach(var currency in CurrencyCache.Currencies)
                        {
                            <option value="@currency.Code">@currency.Name | @currency.Code</option>
                        }
                    </InputSelect>
                </td>
            </tr>
        </tbody>
    </table>
</EditForm>

@code {
    private PlannerModel.ViewModel.Settings ViewModel = new() { UserId = UserCache.UserId };
    private ThemeModeEnum theme
    {
        get => ThemeService.CurrentTheme;
        set => ThemeService.SetTheme(value);
    }

