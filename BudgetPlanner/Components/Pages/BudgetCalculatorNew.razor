@page "/budgetCalculatorNew"
@using BudgetPlanner.Cache
@using BudgetPlanner.Interfaces
@using MudBlazor
@using PlannerModel
@using PlannerModel.ViewModel
@inject IExpenseManager Expense
@inject NavigationManager Navigation
@* ReSharper disable once ConditionIsAlwaysTrueOrFalseAccordingToNullableAPIContract *@

<h1>Ein-/ Ausgaben-Tracker - Neu</h1>
<p>Hier kannst du Einnahmen und Ausgaben verwalten.</p>

@* Anzeige *@
@if (expenses is null)
{
    <p><em>Laden...</em></p>
}
else
{
    // Add Kalendar for better visualization
}

@* Eingabefelder *@


@* Gesamtbetrag *@
<div class="mt-4 font-weight-bold">
    Übriger Gesamtbetrag: <span class="@GetAmountClass(expenses is null ? 0 : expenses.Sum(e => e.Amount))">@expenses?.Sum(e => e.Amount).ToString("0.00") €</span>
</div>

@code {
    // Todo: restruct page
    private List<Expense> expenses = [];
    private Expense newExpense = new();

    protected override async Task OnInitializedAsync()
    {
        
    }

    private string GetAmountClass(decimal amount) => amount < 0 ? "text-danger font-weight-bold" : "text-success font-weight-bold";
}