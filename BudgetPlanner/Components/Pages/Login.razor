@page "/"
@using BudgetPlanner.Cache
@using BudgetPlanner.Interfaces
@using PlannerModel
@using PlannerModel.ViewModel
@inject IBiometricService Biometric
@inject IUserManager User
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 400px;">
        <h2 class="text-center">Willkommen zurück!</h2>
        <p class="text-center">Melde dich mit deinem Konto an.</p>

        @if (_autoLoginAttempted || !_autoLoginAvailable)
        {
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" @bind="_user.Name" placeholder="Dein Name"/>
            </div>

            <div class="mb-3">
                <label class="form-label">Passwort</label>
                <input type="password" class="form-control" @bind="_user.Password" placeholder="Passwort eingeben"/>
            </div>

            <button class="btn custom-btn w-100" @onclick="ManualLogin">Anmelden</button>
        }
        else
        {
            <button class="btn custom-btn w-100" @onclick="BiometricLogin">Anmelden mit Biometrie</button>
        }

        <p class="mt-3 text-center text-danger">@_message</p>

        <p class="mt-3 text-center">
            Noch kein Konto? <a href="/register">Jetzt registrieren</a>
        </p>
    </div>
</div>

@code {
    private User _user = new();
    private string _message = "";
    private bool _autoLoginAttempted;
    private bool _autoLoginAvailable;

    protected override async void OnInitialized()
    {
        // Check if user already logged in
        if (UserCache.UserId > 0)
        {
            bool Logoff = await Application.Current.MainPage.DisplayAlert(
                title: "Nicht möglich",
                message: "Du musst dich abmelden um auf der Seite fortzufahren. Möchtest du dich abmelden?",
                accept: "Ja", 
                cancel: "Nein");

            if (Logoff)
            {
                await User.LogoffUser();
                return;
            }

            Navigation.NavigateTo("/home");
        }

        // Auto login with biometric
        _autoLoginAvailable = await AutoLoginAvailable();
        await BiometricLogin();
    }

    private async Task ManualLogin()
    {
        if (string.IsNullOrWhiteSpace(_user.Name) || string.IsNullOrWhiteSpace(_user.Password))
        {
            _message = "Bitte fülle alle Felder aus!";
            return;
        }

        bool success = await User.LogInUserAsync(_user.Name, _user.Password);

        if (!success)
        {
            _message = "Name oder Passwort ist nicht korrekt.";
            return;
        }

        _message = "Login erfolgreich!";

        // Swith to Home-Page
        Navigation.NavigateTo("/home");
    }

    private async Task BiometricLogin()
    {
        if (_autoLoginAvailable && await Biometric.IsAvailableAsync())
        {
            _autoLoginAttempted = true;
            bool success = await Biometric.AuthenticateAsync("Bitte authentifizieren Sie sich");
            if (success)
            {
                string? storedUser = await SecureStorage.GetAsync("username");
                if (string.IsNullOrWhiteSpace(storedUser))
                    return;

                await User.LogInUserAsync(storedUser, true);
            }
            else
                _autoLoginAttempted = false;
        }
    }

    private static async Task<bool> AutoLoginAvailable()
    {
        string? enabled = await SecureStorage.GetAsync("biometric_enabled");
        return enabled == "true";
    }
}
